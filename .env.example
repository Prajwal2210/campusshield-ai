# Copy to .env for local development. Never commit actual credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Optional, one-time initial administrator. Omit all four to use self-signup.
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_FULLNAME=
STORAGE_PROVIDER=local
VITE_API_URL=/api
# VITE_WS_URL=ws://localhost:8000
