# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
*.db

# Data
backend/data/models/*.joblib
backend/data/reports/*.pdf

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Env
.env
.env.local
.env.*.local
# .env.production is intentionally NOT ignored: frontend/.env.production
# contains only public build-time URLs (VITE_API_URL, VITE_WS_URL) and
# must be committed so Vite bakes the correct backend address into the bundle.
# Secret variants (.env.production.local) are covered by .env.*.local above.

# IDE
.idea/
.vscode/
*.swp
