# Production environment — Render Static Site deployment
# VITE_API_URL: full backend base URL (no trailing slash).
#   Vite bakes this into the bundle at build time via import.meta.env.VITE_API_URL.
#   api.js: const API_BASE = import.meta.env.VITE_API_URL || '/api'
#   Result: all API calls → https://campusshield-ai.onrender.com/api/...
VITE_API_URL=https://campusshield-ai.onrender.com/api

# VITE_WS_URL: WebSocket base URL for the alert stream.
#   useWebSocket.js checks this first; falls back to window.location.host with wss://.
#   Explicit value here is the safest option for cross-origin static hosting.
VITE_WS_URL=wss://campusshield-ai.onrender.com
